{
  "name": "GlobalLinkSubmission",
  "type": "object",
  "description": "Available submissions polled from GlobalLink PD. Lifecycle: available \u2192 claimed | skipped. Acts as the staging table before AcceptedTask/Project is created on claim.",
  "properties": {
    "submission_ticket": {
      "type": "string",
      "description": "GlobalLink submission ticket (primary identity key from PD)."
    },
    "submission_id": {
      "type": "string",
      "description": "Human-readable submission ID shown in the PD UI."
    },
    "submission_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "source_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string",
      "description": "Single target locale this row represents (e.g. tr-TR). One submission can spawn multiple rows."
    },
    "word_count": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase-level deadline from submissionLanguageSearch.pd \u2192 phaseStatusData[0].phaseDueDate. May differ from submission-level due_date."
    },
    "phase_name": {
      "type": "string",
      "description": "Current phase the vendor would claim (e.g. 'PostEdit', 'Translate', 'Review')."
    },
    "workflow_name": {
      "type": "string",
      "description": "Workflow / step template name from PD (e.g. 'NoDownload_FullPE-autoTransIQ1-Finalize Edit (nobudget) (noTMupdate)')."
    },
    "vendor_languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display-name target languages assigned to vendors on this submission (from submissionTargetSearch.pd \u2192 vendorInfos[].targetLanguages, flattened, deduped)."
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "claimed",
        "skipped",
        "error"
      ],
      "default": "available"
    },
    "leverage": {
      "type": "object",
      "description": "TM stats from submissionView.pd \u2192 cumulativeTmStatistics. Populated lazily when user opens detail or clicks Approve. Empty fields stay 0 (e.g. NoLev submissions).",
      "properties": {
        "context": {
          "type": "number"
        },
        "rep": {
          "type": "number"
        },
        "match100": {
          "type": "number"
        },
        "fuzzy_95_99_tm": {
          "type": "number"
        },
        "fuzzy_95_99_reps": {
          "type": "number"
        },
        "fuzzy_85_94_tm": {
          "type": "number"
        },
        "fuzzy_85_94_reps": {
          "type": "number"
        },
        "fuzzy_75_84_tm": {
          "type": "number"
        },
        "fuzzy_75_84_reps": {
          "type": "number"
        },
        "fuzzy_50_74_tm": {
          "type": "number"
        },
        "fuzzy_50_74_reps": {
          "type": "number"
        },
        "no_match": {
          "type": "number"
        },
        "total_wc": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "leverage_fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_error": {
      "type": "string"
    },
    "accepted_task_id": {
      "type": "string",
      "description": "FK to AcceptedTask once claim succeeds."
    },
    "raw": {
      "type": "object",
      "description": "Raw submission payload as received from PD (debug).",
      "additionalProperties": true
    }
  },
  "required": [
    "submission_ticket",
    "target_language"
  ]
}