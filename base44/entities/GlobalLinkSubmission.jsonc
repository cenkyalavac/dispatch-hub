{
  "name": "GlobalLinkSubmission",
  "type": "object",
  "description": "Available submissions polled from GlobalLink PD. One row per (submission_ticket, target_language). Lifecycle: available \u2192 claimed | skipped.",
  "properties": {
    "submission_ticket": {
      "type": "string",
      "description": "GlobalLink submission ticket (primary identity key from PD)."
    },
    "submission_id": {
      "type": "string",
      "description": "Human-readable submission ID shown in the PD UI."
    },
    "submission_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string",
      "description": "Account / client display name. Resolved from PD `paClientName` (primary) with fallbacks to clientName / organizationName."
    },
    "account_id": {
      "type": "string",
      "description": "PA (Project Account) ticket from PD `paClientTicket` \u2014 the stable account identifier."
    },
    "project_name": {
      "type": "string",
      "description": "Project display name from PD `projectName`."
    },
    "source_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string",
      "description": "Single target locale this row represents (e.g. tr-TR)."
    },
    "word_count": {
      "type": "number",
      "description": "Total word count (submission-level from submissionTargetSearch.pd \u2192 wordCount)."
    },
    "weighted_wc": {
      "type": "number",
      "description": "MTPE-aligned WWC. Formula: (95-99 + Reps95-99)*0.2 + (85-94 + Reps85-94)*0.35 + (75-84 + Reps75-84)*0.45 + (50-74 + Reps50-74 + noMatch)*0.6. Computed client-side; not returned by PD."
    },
    "lev_context": {
      "type": "number",
      "description": "Context match (inContextMatch) word count for this target locale."
    },
    "lev_rep": {
      "type": "number",
      "description": "Pure cross-segment repetitions word count."
    },
    "lev_match100": {
      "type": "number",
      "description": "100% match word count."
    },
    "lev_9599": {
      "type": "number",
      "description": "95-99% fuzzy (PURE \u2014 Reps95-99 lives in lev_rep_9599)."
    },
    "lev_8594": {
      "type": "number",
      "description": "85-94% fuzzy (PURE)."
    },
    "lev_7584": {
      "type": "number",
      "description": "75-84% fuzzy (PURE)."
    },
    "lev_5074": {
      "type": "number",
      "description": "50-74% fuzzy (PURE)."
    },
    "lev_rep_9599": {
      "type": "number",
      "description": "Reps95-99% \u2014 repetitions falling into the 95-99 fuzzy band."
    },
    "lev_rep_8594": {
      "type": "number",
      "description": "Reps85-94%."
    },
    "lev_rep_7584": {
      "type": "number",
      "description": "Reps75-84%."
    },
    "lev_rep_5074": {
      "type": "number",
      "description": "Reps50-74%."
    },
    "lev_no_match": {
      "type": "number",
      "description": "No-match word count."
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase-level deadline from submissionLanguageSearch.pd \u2192 subPhaseStatusDataHolders[0].phaseStatusData[0].phaseDueDate.date (epoch ms)."
    },
    "phase_name": {
      "type": "string",
      "description": "Current phase the vendor would claim (e.g. 'PostEdit', 'Translate', 'Review')."
    },
    "workflow_name": {
      "type": "string",
      "description": "Workflow / step template name from PD."
    },
    "vendor_languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display-name target languages assigned to vendors on this submission."
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "claimed",
        "skipped",
        "error"
      ],
      "default": "available"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_error": {
      "type": "string"
    },
    "accepted_task_id": {
      "type": "string",
      "description": "FK to AcceptedTask once claim succeeds."
    },
    "raw": {
      "type": "object",
      "description": "Raw submission payload (debug).",
      "additionalProperties": true
    }
  },
  "required": [
    "submission_ticket",
    "target_language"
  ]
}