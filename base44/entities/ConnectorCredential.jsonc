{
  "name": "ConnectorCredential",
  "type": "object",
  "description": "One row per broker account. An external broker holds a logged-in session to a translation portal; this entity is the control surface an admin uses to update passwords and drive re-login (incl. MFA) without the command line. The UI reads/writes this; the broker performs the real login. password and smsCode are sensitive and never rendered back to the UI.",
  "properties": {
    "accountKey": {
      "type": "string",
      "description": "Unique stable key for the broker account. e.g. 'globallink', 'ws-lionbridge-en-tr', 'ws-rws-en-tr', 'ws-toin-en-tr', 'ws-toin-en-ar', 'ws-toin-en-ru', 'welocalize'."
    },
    "connector": {
      "type": "string",
      "description": "Connector family: 'globallink' | 'worldserver' | 'welocalize'."
    },
    "label": {
      "type": "string",
      "description": "Human label, e.g. 'GlobalLink \u2014 Transperfect', 'WorldServer \u00b7 Lionbridge EN\u2192TR'."
    },
    "login": {
      "type": "string",
      "description": "Username / email used to log in to the portal."
    },
    "password": {
      "type": "string",
      "description": "SENSITIVE. Portal password. Write-only from the UI \u2014 masked everywhere, the stored value is never rendered back."
    },
    "mfaType": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "none"
      ],
      "default": "none",
      "description": "MFA challenge type the broker must satisfy during login."
    },
    "mfaMailbox": {
      "type": "string",
      "description": "For email OTP: the inbox the verification code lands in (e.g. cenk@eltur.co)."
    },
    "sessionStatus": {
      "type": "string",
      "enum": [
        "connected",
        "needs_login",
        "logging_in",
        "awaiting_sms",
        "error"
      ],
      "default": "needs_login",
      "description": "Current broker session state for this account."
    },
    "statusMessage": {
      "type": "string",
      "description": "Free-text detail from the broker about the current status / last error."
    },
    "lastLoginAt": {
      "type": "string",
      "description": "When the broker last completed a successful login (ISO or display string)."
    },
    "reauthState": {
      "type": "string",
      "enum": [
        "idle",
        "requested",
        "awaiting_sms",
        "submitting",
        "done",
        "failed"
      ],
      "default": "idle",
      "description": "Drives the re-login handshake between the UI and the broker."
    },
    "smsCode": {
      "type": "string",
      "description": "SENSITIVE, transient. User-entered SMS/OTP code, consumed by the broker. Write-only from the UI, never rendered back."
    },
    "reauthRequestedAt": {
      "type": "string",
      "description": "When the admin last requested re-authentication (ISO or display string)."
    }
  },
  "required": [
    "accountKey",
    "connector",
    "label"
  ]
}