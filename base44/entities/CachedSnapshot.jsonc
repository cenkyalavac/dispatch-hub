{
  "name": "CachedSnapshot",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique cache key (e.g. history_symfonie_30, pending_symfonie)"
    },
    "data": {
      "type": "object",
      "description": "Cached payload (tasks array + metadata)",
      "additionalProperties": true
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the snapshot was last refreshed from source"
    },
    "source_function": {
      "type": "string",
      "description": "Which backend function produced this snapshot"
    },
    "item_count": {
      "type": "integer",
      "description": "Number of items in the snapshot (for quick display)"
    }
  },
  "required": [
    "key"
  ]
}