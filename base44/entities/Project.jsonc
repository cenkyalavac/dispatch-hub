{
  "name": "Project",
  "type": "object",
  "description": "BeLazy-style project record exposed to downstream BMS systems. One project per accepted task.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Owning tenant. Defaults to 'default' until multi-tenant is enabled.",
      "default": "default"
    },
    "client_id": {
      "type": "string",
      "description": "FK to Client.id \u2014 the agency end-client this project belongs to. Propagated from the originating Portal at accept time. BMS systems filter on this to attribute projects to the correct end-customer."
    },
    "accepted_task_id": {
      "type": "string",
      "description": "Source AcceptedTask record id (1:1)."
    },
    "portal": {
      "type": "string",
      "description": "Origin portal key (symfonie, junction, ...)"
    },
    "external_id": {
      "type": "string",
      "description": "Stable cross-system project id (e.g. 'symfonie:12345')."
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "synchronized",
        "delivered",
        "failed_to_sync"
      ],
      "default": "accepted",
      "description": "BeLazy-style lifecycle state."
    },
    "name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "source_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "word_count": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the downstream BMS acknowledged receipt (state -> synchronized)."
    },
    "acknowledged_by": {
      "type": "string",
      "description": "API key id that acknowledged the project."
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_error": {
      "type": "string",
      "description": "Last sync error message, when state is failed_to_sync."
    },
    "vendor_payment": {
      "type": "object",
      "additionalProperties": true,
      "description": "Vendor-side financial breakdown surfaced from the originating AcceptedTask. Symfonie source: PurchaseOrder.Prices (we are the vendor \u2014 this is what Moravia/Welocalize owes us). Shape: { partner_id, partner_code, partner_name, currency, unit_cost, partner_price, usd_unit_cost, usd_price }. Null when the portal didn't supply a PO at accept time."
    },
    "project_notes": {
      "type": "string",
      "description": "Free-text project-level instructions / special handling notes from the originating portal. Symfonie source: Project.Notes. BMS-facing field \u2014 Dispatch reads it to brief PMs."
    },
    "origin": {
      "type": "object",
      "additionalProperties": true,
      "description": "Raw representation as it arrived from the source portal."
    }
  },
  "required": [
    "tenant_id",
    "portal",
    "external_id",
    "state"
  ]
}