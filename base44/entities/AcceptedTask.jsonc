{
  "name": "AcceptedTask",
  "type": "object",
  "properties": {
    "portal": {
      "type": "string",
      "description": "Kaynak portal (symfonie, junction, globallink, ...)",
      "default": "symfonie"
    },
    "task_id": {
      "type": "integer",
      "description": "Portal Task ID"
    },
    "task_name": {
      "type": "string",
      "description": "Task ad\u0131"
    },
    "project_name": {
      "type": "string",
      "description": "Proje ad\u0131"
    },
    "client_name": {
      "type": "string",
      "description": "M\u00fc\u015fteri / hesap ad\u0131"
    },
    "account_id": {
      "type": "string",
      "description": "Portal-specific stable account identifier (e.g. GlobalLink paClientTicket)."
    },
    "source_language": {
      "type": "string",
      "description": "Kaynak dil kodu"
    },
    "target_language": {
      "type": "string",
      "description": "Hedef dil kodu"
    },
    "word_count": {
      "type": "number",
      "description": "Toplam kelime say\u0131s\u0131 (submission-level)"
    },
    "price": {
      "type": "number",
      "description": "Fiyat/maliyet"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Teslim tarihi"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kabul tarihi ve saati"
    },
    "matched_rule": {
      "type": "string",
      "description": "Uygulanan kural ad\u0131"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "error"
      ],
      "default": "accepted"
    },
    "sheets_synced": {
      "type": "boolean",
      "default": false,
      "description": "Google Sheets'e kaydedildi mi?"
    },
    "weighted_wc": {
      "type": "number",
      "description": "GlobalLink: MTPE-aligned WWC. Formula: (95-99 + Reps95-99)*0.2 + (85-94 + Reps85-94)*0.35 + (75-84 + Reps75-84)*0.45 + (50-74 + Reps50-74 + noMatch)*0.6. Context/rep/100% bands carry zero weight."
    },
    "lev_context": {
      "type": "number",
      "description": "GlobalLink leverage band: in-context match (pure)."
    },
    "lev_rep": {
      "type": "number",
      "description": "GlobalLink leverage band: pure repetitions (cross-segment)."
    },
    "lev_match100": {
      "type": "number",
      "description": "GlobalLink leverage band: 100% match (pure)."
    },
    "lev_9599": {
      "type": "number",
      "description": "GlobalLink leverage band: 95-99% fuzzy (PURE \u2014 does NOT include Reps95-99). Use lev_rep_9599 for the reps slice."
    },
    "lev_8594": {
      "type": "number",
      "description": "GlobalLink leverage band: 85-94% fuzzy (PURE \u2014 does NOT include Reps85-94)."
    },
    "lev_7584": {
      "type": "number",
      "description": "GlobalLink leverage band: 75-84% fuzzy (PURE \u2014 does NOT include Reps75-84)."
    },
    "lev_5074": {
      "type": "number",
      "description": "GlobalLink leverage band: 50-74% fuzzy (PURE \u2014 does NOT include Reps50-74)."
    },
    "lev_rep_9599": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps95-99% (repetitions falling into the 95-99 fuzzy band)."
    },
    "lev_rep_8594": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps85-94%."
    },
    "lev_rep_7584": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps75-84%."
    },
    "lev_rep_5074": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps50-74%."
    },
    "lev_no_match": {
      "type": "number",
      "description": "GlobalLink leverage band: no-match words."
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "GlobalLink: phase-level deadline (PD subPhaseStatusDataHolders)."
    },
    "phase_name": {
      "type": "string",
      "description": "GlobalLink: claimed phase (PostEdit, Translate, Review)."
    },
    "workflow_name": {
      "type": "string",
      "description": "GlobalLink / Symfonie: workflow / step template name."
    },
    "submission_id": {
      "type": "string",
      "description": "GlobalLink: human-readable submission ID from PD UI."
    },
    "submission_ticket": {
      "type": "string",
      "description": "GlobalLink: PD submission ticket (primary key in PD)."
    }
  },
  "required": [
    "task_id",
    "task_name",
    "portal"
  ]
}