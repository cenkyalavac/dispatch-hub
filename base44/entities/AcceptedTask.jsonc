{
  "name": "AcceptedTask",
  "type": "object",
  "properties": {
    "portal": {
      "type": "string",
      "description": "Kaynak portal (symfonie, junction, globallink, ...)",
      "default": "symfonie"
    },
    "task_id": {
      "type": "integer",
      "description": "Portal Task ID"
    },
    "task_name": {
      "type": "string",
      "description": "Task ad\u0131"
    },
    "project_name": {
      "type": "string",
      "description": "Proje ad\u0131"
    },
    "client_name": {
      "type": "string",
      "description": "M\u00fc\u015fteri / hesap ad\u0131"
    },
    "account_id": {
      "type": "string",
      "description": "Portal-specific stable account identifier (e.g. GlobalLink paClientTicket)."
    },
    "source_language": {
      "type": "string",
      "description": "Kaynak dil kodu"
    },
    "target_language": {
      "type": "string",
      "description": "Hedef dil kodu"
    },
    "word_count": {
      "type": "number",
      "description": "Toplam kelime say\u0131s\u0131 (submission-level)"
    },
    "price": {
      "type": "number",
      "description": "Fiyat/maliyet"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Teslim tarihi"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kabul tarihi ve saati"
    },
    "matched_rule": {
      "type": "string",
      "description": "Uygulanan kural ad\u0131"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "error"
      ],
      "default": "accepted"
    },
    "sheets_synced": {
      "type": "boolean",
      "default": false,
      "description": "Google Sheets'e kaydedildi mi?"
    },
    "weighted_wc": {
      "type": "number",
      "description": "GlobalLink: MTPE-aligned WWC. Formula: (95-99 + Reps95-99)*0.2 + (85-94 + Reps85-94)*0.35 + (75-84 + Reps75-84)*0.45 + (50-74 + Reps50-74 + noMatch)*0.6. Context/rep/100% bands carry zero weight."
    },
    "lev_context": {
      "type": "number",
      "description": "Leverage band: in-context / context-TM match (pure)."
    },
    "lev_rep": {
      "type": "number",
      "description": "Leverage band: pure repetitions (cross-segment)."
    },
    "lev_match100": {
      "type": "number",
      "description": "Leverage band: 100% match (pure)."
    },
    "lev_9599": {
      "type": "number",
      "description": "Leverage band: 95-99% fuzzy (PURE \u2014 does NOT include Reps95-99). Use lev_rep_9599 for the reps slice."
    },
    "lev_8594": {
      "type": "number",
      "description": "Leverage band: 85-94% fuzzy (PURE \u2014 does NOT include Reps85-94)."
    },
    "lev_7584": {
      "type": "number",
      "description": "Leverage band: 75-84% fuzzy (PURE \u2014 does NOT include Reps75-84)."
    },
    "lev_5074": {
      "type": "number",
      "description": "Leverage band: 50-74% fuzzy (PURE \u2014 does NOT include Reps50-74)."
    },
    "lev_rep_9599": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps95-99% (repetitions falling into the 95-99 fuzzy band)."
    },
    "lev_rep_8594": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps85-94%."
    },
    "lev_rep_7584": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps75-84%."
    },
    "lev_rep_5074": {
      "type": "number",
      "description": "GlobalLink leverage band: Reps50-74%."
    },
    "lev_no_match": {
      "type": "number",
      "description": "Leverage band: no-match words."
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "GlobalLink: phase-level deadline (PD subPhaseStatusDataHolders)."
    },
    "phase_name": {
      "type": "string",
      "description": "GlobalLink: claimed phase (PostEdit, Translate, Review)."
    },
    "workflow_name": {
      "type": "string",
      "description": "GlobalLink / Symfonie: workflow / step template name."
    },
    "submission_id": {
      "type": "string",
      "description": "GlobalLink: human-readable submission ID from PD UI."
    },
    "submission_ticket": {
      "type": "string",
      "description": "GlobalLink: PD submission ticket (primary key in PD)."
    },
    "symfonie_link": {
      "type": "string",
      "description": "Symfonie: deep link to the task in the Moravia Projects web UI (https://projects.moravia.com/Jobs/Detail/{JobId}#task-{TaskId})."
    },
    "symfonie_code": {
      "type": "string",
      "description": "Symfonie: short Project.Code (max 20 chars). Belazy 'Symfonie Code' column."
    },
    "parser_type": {
      "type": "string",
      "description": "Symfonie: ParserType of the WordCountAnalysis the leverage bands came from (e.g. MemSource, TradosStudio, MemoQ, XTM). Empty when no analysis is attached."
    },
    "order_date": {
      "type": "string",
      "format": "date-time",
      "description": "Symfonie: Task.OrderDate \u2014 when the task was ordered to us (distinct from accepted_at)."
    },
    "job_id": {
      "type": "integer",
      "description": "Symfonie: parent Job.Id. Used to build deep links and for downstream BMS correlation."
    },
    "job_identifier": {
      "type": "string",
      "description": "Symfonie: Job.Identifier (ERP identifier) \u2014 stable cross-system reference."
    },
    "project_id": {
      "type": "integer",
      "description": "Symfonie: parent Project.Id (Symfonie's own internal ID, not our BMS Project entity)."
    },
    "project_manager_first_name": {
      "type": "string",
      "description": "Project manager first name (resolved via /Users(ProjectManagerId))."
    },
    "project_manager_last_name": {
      "type": "string",
      "description": "Project manager last name (resolved via /Users(ProjectManagerId))."
    }
  },
  "required": [
    "task_id",
    "task_name",
    "portal"
  ]
}