{
  "name": "AcceptedTask",
  "type": "object",
  "properties": {
    "portal": {
      "type": "string",
      "description": "Kaynak portal (symfonie, junction, globallink, ...)",
      "default": "symfonie"
    },
    "task_id": {
      "type": "integer",
      "description": "Portal Task ID"
    },
    "task_name": {
      "type": "string",
      "description": "Task ad\u0131"
    },
    "project_name": {
      "type": "string",
      "description": "Proje ad\u0131"
    },
    "client_name": {
      "type": "string",
      "description": "M\u00fc\u015fteri / hesap ad\u0131"
    },
    "account_id": {
      "type": "string",
      "description": "Portal-specific stable account identifier (e.g. GlobalLink paClientTicket)."
    },
    "source_language": {
      "type": "string",
      "description": "Kaynak dil kodu"
    },
    "target_language": {
      "type": "string",
      "description": "Hedef dil kodu"
    },
    "word_count": {
      "type": "number",
      "description": "Toplam kelime say\u0131s\u0131 (submission-level)"
    },
    "price": {
      "type": "number",
      "description": "Fiyat/maliyet"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Teslim tarihi"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kabul tarihi ve saati"
    },
    "matched_rule": {
      "type": "string",
      "description": "Uygulanan kural ad\u0131"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "error"
      ],
      "default": "accepted"
    },
    "sheets_synced": {
      "type": "boolean",
      "default": false,
      "description": "Google Sheets'e kaydedildi mi?"
    },
    "weighted_wc": {
      "type": "number",
      "description": "GlobalLink: 12-bant leverage'dan hesaplanm\u0131\u015f weighted word count (WWC)."
    },
    "lev_context": {
      "type": "number",
      "description": "GlobalLink leverage band: in-context match."
    },
    "lev_rep": {
      "type": "number",
      "description": "GlobalLink leverage band: repetitions."
    },
    "lev_match100": {
      "type": "number",
      "description": "GlobalLink leverage band: 100% match."
    },
    "lev_9599": {
      "type": "number",
      "description": "GlobalLink leverage band: 95-99% fuzzy + reps."
    },
    "lev_8594": {
      "type": "number",
      "description": "GlobalLink leverage band: 85-94% fuzzy + reps."
    },
    "lev_7584": {
      "type": "number",
      "description": "GlobalLink leverage band: 75-84% fuzzy + reps."
    },
    "lev_5074": {
      "type": "number",
      "description": "GlobalLink leverage band: 50-74% fuzzy + reps."
    },
    "lev_no_match": {
      "type": "number",
      "description": "GlobalLink leverage band: no-match words."
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "GlobalLink: phase-level deadline (PD subPhaseStatusDataHolders)."
    },
    "phase_name": {
      "type": "string",
      "description": "GlobalLink: claimed phase (PostEdit, Translate, Review)."
    },
    "workflow_name": {
      "type": "string",
      "description": "GlobalLink / Symfonie: workflow / step template name."
    },
    "submission_id": {
      "type": "string",
      "description": "GlobalLink: human-readable submission ID from PD UI."
    },
    "submission_ticket": {
      "type": "string",
      "description": "GlobalLink: PD submission ticket (primary key in PD)."
    }
  },
  "required": [
    "task_id",
    "task_name",
    "portal"
  ]
}