{
  "name": "Portal",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique identifier (e.g. symfonie, junction)"
    },
    "name": {
      "type": "string",
      "description": "Display name (e.g. Moravia Symfonie)"
    },
    "vendor": {
      "type": "string",
      "description": "Parent vendor / company (e.g. Moravia, Welocalize)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the portal is enabled"
    },
    "description": {
      "type": "string",
      "description": "Short description shown on the connector card"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "color": {
      "type": "string",
      "description": "Accent color (tailwind hue, e.g. blue, purple, emerald)"
    },
    "auth_type": {
      "type": "string",
      "enum": [
        "oauth2_client_credentials",
        "jwt_bearer",
        "api_key",
        "none"
      ],
      "description": "How this portal authenticates"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error",
        "not_configured"
      ],
      "default": "not_configured",
      "description": "Latest connection check result"
    },
    "connection_message": {
      "type": "string",
      "description": "Latest connection status detail (error message etc.)"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful poll/sync timestamp"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last connection test timestamp"
    },
    "docs_url": {
      "type": "string",
      "description": "Official API documentation URL"
    },
    "required_secrets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Secret names required for this portal to work"
    },
    "process_function": {
      "type": "string",
      "description": "Backend function name to run rule-based automation"
    },
    "test_function": {
      "type": "string",
      "description": "Backend function name to test the connection"
    },
    "fetch_function": {
      "type": "string",
      "description": "Backend function that returns the pending tasks list"
    },
    "accept_function": {
      "type": "string",
      "description": "Backend function that accepts a single task manually"
    },
    "reject_function": {
      "type": "string",
      "description": "Backend function that rejects a single task manually (optional)"
    },
    "history_function": {
      "type": "string",
      "description": "Backend function that returns completed/approved task history (optional)"
    },
    "dropbox_base_path": {
      "type": "string",
      "description": "Dropbox root folder for this portal's handoffs. Falls back to global app setting if empty."
    },
    "dropbox_folder_template": {
      "type": "string",
      "description": "Folder template under base path. Tokens: {account} {project} {task_id} {task_name}. Falls back to global app setting if empty."
    },
    "sheets_spreadsheet_id": {
      "type": "string",
      "description": "Google Sheets spreadsheet ID where this portal's accepted tasks are logged. Falls back to GOOGLE_SHEETS_SPREADSHEET_ID secret if empty."
    },
    "sheets_tab_name": {
      "type": "string",
      "description": "Worksheet/tab name within the spreadsheet (e.g. 'Sheet1'). Defaults to the first sheet if empty."
    },
    "allowed_language_families": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ISO 639-1 language code prefixes (e.g. ['tr','ar']). Submission targetLanguage.locale start-with match \u2014 'tr' covers tr-TR, tr_TR, tr-x-foo; 'ar' covers ar-SA, ar-EG, ar-MSA, etc. Empty array = no filter (claim all available). Add a new family to onboard a new language pair without touching code."
    },
    "rule_fields": {
      "type": "array",
      "description": "Connector-specific field definitions used by rules, mappings, and routing. Each portal defines its own field vocabulary \u2014 no hardcoded cross-portal field list. Empty array = no portal-specific fields (falls back to defaults).",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Entity field name as stored on AcceptedTask/GlobalLinkSubmission (e.g. 'workflow_name')"
          },
          "label": {
            "type": "string",
            "description": "Human label shown in the UI (e.g. 'Workflow')"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number"
            ],
            "default": "string"
          },
          "operators": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "equals",
                "contains",
                "not_contains",
                "starts_with",
                "greater_than",
                "less_than",
                "greater_equal",
                "less_equal"
              ]
            },
            "description": "Allowed operators for this field. Defaults to standard text or numeric ops based on type."
          }
        }
      }
    }
  },
  "required": [
    "key",
    "name"
  ]
}