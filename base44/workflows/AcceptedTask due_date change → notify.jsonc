{
  "name": "AcceptedTask due_date change \u2192 notify",
  "description": "Fires whenever an AcceptedTask's due_date is modified. Creates a UserNotification, updates the linked Project, fires project.updated webhook to subscribed BMSes, and rewrites the Google Sheets row.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"due_date\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "AcceptedTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "acceptedtask_due_date_change_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleDueDateChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "handleDueDateChange"
  }
}