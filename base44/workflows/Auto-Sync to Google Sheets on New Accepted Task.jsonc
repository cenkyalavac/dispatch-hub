{
  "name": "Auto-Sync to Google Sheets on New Accepted Task",
  "description": "When a new AcceptedTask is created (manual or auto-accepted), immediately sync all pending tasks to Google Sheets.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"accepted\") and (.trigger.data.sheets_synced == false)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AcceptedTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_to_google_sheets_on_new_accepted_task",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sheetsSyncPending",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sheetsSyncPending"
  }
}