{
  "name": "Symfonie Due Date Sync (every 30 min)",
  "description": "Polls Symfonie every 30 minutes for due_date changes on already-accepted, still-open tasks. Only the due_date field is reconciled. Updates trigger the existing `handleDueDateChange` entity automation, which handles in-app notifications, Project + BMS webhook, Google Sheets row rewrite, and admin email.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-05-16T10:25:56.747000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "symfonie_due_date_sync_every_30_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "symfonieSyncAcceptedDueDates",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "symfonieSyncAcceptedDueDates"
  }
}