{
  "name": "Refresh History snapshot (every 4h)",
  "description": "Calls symfonieHistory every 4 hours to keep the History page snapshot fresh. Users see instant data on page open.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 4,
      "interval_unit": "hours",
      "interval_anchor": "2026-05-12T08:05:14.954000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "refresh_history_snapshot_every_4h",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "symfonieHistory",
            "args": {
              "days": 30
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "symfonieHistory"
  }
}