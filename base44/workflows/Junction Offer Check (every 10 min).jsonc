{
  "name": "Junction Offer Check (every 10 min)",
  "description": "Polls Welocalize Junction /v2/offer/me every 10 minutes, applies rules, accepts/rejects matches, and emails recipients for unmatched offers. Respects the Portal kill switch \u2014 does nothing when the Junction portal is toggled off.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-05-16T09:34:40.475000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "junction_offer_check_every_10_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "junctionProcessOffers",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
